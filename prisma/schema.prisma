generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}


model Equipment {
  id                  String        @id @default(uuid())
  name                String
  category            String
  serialNumber        String        @unique
  dailyRate           Float
  imageUrl            String?
  stock               Int           @default(1)
  rentedOut           Int           @default(0)
  description         String?
  mount               String?
  resolution          String?
  keyFeatures         String?
  includedAccessories String?
  bookingItems        BookingItem[]
  createdAt           DateTime      @default(now())
}

model Booking {
  id             String        @id @default(uuid())
  doNumber       String        @unique
  customerName   String
  phone          String
  identityNo     String
  email          String?
  deliveryMethod String
  address        String?
  paymentMethod  String
  notes          String?
  totalPrice     Float
  status         String        @default("CONFIRMED")
  startDate      DateTime?
  endDate        DateTime?
  items          BookingItem[]
  createdAt      DateTime      @default(now())
}

model BookingItem {
  id          String     @id @default(uuid())
  bookingId   String
  booking     Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  quantity    Int        @default(1)
  startDate   String
  endDate     String
  subtotal    Float
}